# Neon pooled connection string. Without it the site runs in demo mode.
DATABASE_URL=
# 32+ random characters (openssl rand -base64 32). Signs sessions and hashes access keys.
BETTER_AUTH_SECRET=
# Public URL of the site, e.g. https://techbash.example.com (optional on Vercel).
BETTER_AUTH_URL=
# Vercel Blob read-write token. Enables team and faculty photo uploads.
BLOB_READ_WRITE_TOKEN=
